# People Helper configuration

# REQUIRED: Fine-grained GitHub PAT
# Create at https://github.com/settings/personal-access-tokens/new
#
# Settings:
#   - Resource owner: ONLY the specific repos you want to analyze
#   - Repository access: "Only select repositories" (not "All repositories")
#   - Permissions:
#       - Contents: Read
#       - Metadata: Read (auto-selected)
#   - No other permissions
#   - Expiration: 90 days or less (rotate regularly)
#
# DO NOT USE:
#   - Classic PATs with 'repo' scope (too broad)
#   - Fine-grained PATs with Contents: Write
#   - PATs scoped to "All repositories"
PEOPLE_HELPER_PAT=github_pat_replace_me
